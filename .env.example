# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# GitHub > Settings > Secrets and variables > Actions > Variables (publicação).
# Todas são opcionais: sem elas o site funciona e guarda o cadastro só no navegador.

# Banco de dados e login social (Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_PROVIDERS=google,azure,apple

# Google AdSense (exige domínio próprio aprovado)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_TRAIL=

# E-mail exibido na Política de Privacidade e em "Anuncie / Parcerias"
VITE_CONTACT_EMAIL=

# Só para o script de ilustrações (npm run art). Nunca use prefixo VITE_ aqui.
GEMINI_API_KEY=
